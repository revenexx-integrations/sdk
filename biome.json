{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "files": {
    "ignore": ["dist", "node_modules", "coverage", ".vitest-cache"]
  },
  "organizeImports": { "enabled": false },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 200
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "off", "noAssignInExpressions": "off" },
      "style": {
        "useImportType": "off",
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "off",
        "noParameterAssign": "off",
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": { "fetch": "Use safeFetch: a raw fetch skips assertPublicUrl (PO-185). src/fetch.ts is the one sanctioned exception." }
          }
        }
      },
      "complexity": { "noForEach": "off", "useLiteralKeys": "off", "useArrowFunction": "off" },
      "performance": { "noDelete": "off" },
      "correctness": { "noUnusedVariables": "warn" },
      "security": { "noGlobalEval": "error" }
    }
  }
}
